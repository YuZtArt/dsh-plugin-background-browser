{
  "name": "dshplugins-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace dsh-plugin-starter",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "pack:starter": "npm pack --workspace dsh-plugin-starter",
    "pack:browser": "npm pack --workspace dsh-plugin-background-browser",
    "browser:install": "npm run browser:install --workspace dsh-plugin-background-browser",
    "test:browser": "npm run build && node --test tests/browser.e2e.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@types/node": "22.20.3",
    "@types/react": "18.3.28",
    "esbuild": "0.25.12",
    "node": "22.23.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.2"
  }
}
